# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ad-hoc screenshot scripts
/shot.mjs

# Source design exports (Figma PNGs shared for reference).
# Kept locally, never committed — they are the designer's unreleased work and
# nothing in the app serves them. Assets the app DOES serve live in
# public/figma and public/categories and are tracked.
/design/

# Claude Code worktrees (local tooling state)
/.claude/

# Live-app screengrabs the /userjourney route was measured from.
# Same class as /design/ — reference source, nothing in the app serves them.
/userflow/

# Throwaway measurement scripts. The /userjourney frames are re-measured off the
# running app rather than eyeballed, which means a lot of one-shot Playwright
# scripts that have to live in the repo root for `import { chromium }` to
# resolve. They are working notes, not source, and six were swept into a commit
# on 2026-09-07 by a pass that ran `git add -A` while several were on disk.
__*.mjs
_*.mjs
